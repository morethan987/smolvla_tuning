<mujoco model="pick_place">
  <!-- SO-100 机械臂(含 smolvla_tuning 补丁:grasp_site + wrist 相机) -->
  <include file="so_arm100.xml"/>

  <visual>
    <headlight ambient="0.25 0.25 0.25" diffuse="0.55 0.55 0.55"/>
    <global offwidth="224" offheight="224"/>
  </visual>

  <worldbody>
    <light pos="0.4 -0.4 0.9" dir="-0.2 0.2 -1" directional="true"/>
    <light pos="-0.5 0.3 0.8" dir="0.3 -0.2 -1" directional="true"/>

    <!-- 桌面(z=0),机械臂底座与任务物件都置于其上 -->
    <geom name="table" type="plane" size="0.7 0.7 1" rgba="0.72 0.62 0.5 1"/>

    <!-- 红色方块:3cm 立方体,freejoint 自由刚体,reset 时随机化 -->
    <body name="red_cube" pos="0 -0.22 0.0155">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.015 0.015 0.015" mass="0.03"
            friction="1 0.005 0.0001" rgba="0.85 0.1 0.1 1"/>
    </body>

    <!-- 托盘:内半宽 0.075m,墙高 0.032m,固定于 (0.21, -0.08) -->
    <body name="tray" pos="0.21 -0.08 0">
      <geom name="tray_bottom" type="box" pos="0 0 0.004" size="0.079 0.079 0.004" rgba="0.2 0.35 0.7 1"/>
      <geom name="tray_wall_n" type="box" pos="0 0.079 0.016" size="0.083 0.004 0.016" rgba="0.25 0.4 0.75 1"/>
      <geom name="tray_wall_s" type="box" pos="0 -0.079 0.016" size="0.083 0.004 0.016" rgba="0.25 0.4 0.75 1"/>
      <geom name="tray_wall_e" type="box" pos="0.079 0 0.016" size="0.004 0.083 0.016" rgba="0.25 0.4 0.75 1"/>
      <geom name="tray_wall_w" type="box" pos="-0.079 0 0.016" size="0.004 0.083 0.016" rgba="0.25 0.4 0.75 1"/>
    </body>

    <!-- 全局俯视相机 -->
    <camera name="top" pos="0.03 -0.12 0.85" xyaxes="1 0 0 0 -1 0" fovy="45"/>
  </worldbody>
</mujoco>
