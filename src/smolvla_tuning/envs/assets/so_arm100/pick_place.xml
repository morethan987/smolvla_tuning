<mujoco model="pick_place">
  <!-- SO-100 机械臂 -->
  <include file="so_arm100.xml"/>

  <!-- 视觉效果：开启4倍抗锯齿，调低探照灯避免过曝 -->
  <visual>
    <headlight ambient="0.15 0.15 0.15" diffuse="0.25 0.25 0.25" specular="0 0 0"/>
    <quality shadowsize="2048" offsamples="4"/>
    <global offwidth="224" offheight="224"/>
  </visual>

  <!-- 增加真实纹理与深灰/哑光桌面材质，突显白色机械臂与红方块 -->
  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.25 0.26 0.28"
             rgb2="0.2 0.21 0.23" markrgb="0.3 0.3 0.3" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
              reflectance="0.05" roughness="0.8"/>
  </asset>

  <worldbody>
    <!-- 主定向光(带柔和阴影)与侧方补光 -->
    <light pos="0.3 -0.4 1.2" dir="-0.3 0.3 -1" diffuse="0.65 0.65 0.65" specular="0.2 0.2 0.2" castshadow="true"/>
    <light pos="-0.4 0.2 1.0" dir="0.3 -0.2 -1" diffuse="0.3 0.3 0.3" specular="0.05 0.05 0.05" castshadow="false"/>

    <!-- 哑光桌面 (z=0) -->
    <geom name="table" type="plane" size="0.7 0.7 1" material="groundplane"/>

    <!-- 红色方块: 3cm 立方体 -->
    <body name="red_cube" pos="0 -0.22 0.0155">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.015 0.015 0.015" mass="0.03"
            friction="1 0.005 0.0001" rgba="0.9 0.15 0.15 1"/>
    </body>

    <!-- 托盘: 固定于 (0.21, -0.08) -->
    <body name="tray" pos="0.21 -0.08 0">
      <geom name="tray_bottom" type="box" pos="0 0 0.004" size="0.079 0.079 0.004" rgba="0.15 0.35 0.75 1"/>
      <geom name="tray_wall_n" type="box" pos="0 0.079 0.016" size="0.083 0.004 0.016" rgba="0.2 0.45 0.85 1"/>
      <geom name="tray_wall_s" type="box" pos="0 -0.079 0.016" size="0.083 0.004 0.016" rgba="0.2 0.45 0.85 1"/>
      <geom name="tray_wall_e" type="box" pos="0.079 0 0.016" size="0.004 0.083 0.016" rgba="0.2 0.45 0.85 1"/>
      <geom name="tray_wall_w" type="box" pos="-0.079 0 0.016" size="0.004 0.083 0.016" rgba="0.2 0.45 0.85 1"/>
    </body>

    <!-- 全局俯视相机：稍微降低高度(0.65m)，焦距收紧，让操作区占满画面 -->
    <camera name="top" pos="0.18 -0.52 0.38" xyaxes="0.88 0.47 0 -0.22 0.41 0.88" fovy="52"/>
  </worldbody>
</mujoco>
